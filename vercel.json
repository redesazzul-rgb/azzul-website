{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/icf", "destination": "/icf.html" },
    { "source": "/productos", "destination": "/productos.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/ebook", "destination": "/ebook.html" },
    { "source": "/rentas", "destination": "/rentas.html" },
    { "source": "/detalle", "destination": "/detalle.html" },
    { "source": "/success", "destination": "/success.html" },
    { "source": "/transferencia", "destination": "/transferencia.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
